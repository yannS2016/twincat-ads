+/* PROFILING instrumentation: timestamped, unthrottled, log-only. */
+#include <stdarg.h>
+static void profLog(const char* tag, const char* fmt, ...)
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    struct tm tmv;
+    time_t t = tv.tv_sec;
+    localtime_r(&t, &tmv);
+    char ts[32];
+    strftime(ts, sizeof ts, "%H:%M:%S", &tmv);
+    char msg[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(msg, sizeof msg, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "PROF %s.%03d %s %s\n", ts, (int)(tv.tv_usec / 1000), tag, msg);
+    fflush(stderr);
+}
 static adsAsynPortDriver* adsAsynPortObj;
