+/** Gets new symbolic handles for the parameters whose bulk read failed with 0x710 and updates their bulk entry.
+ * Parameters that still fail keep refreshNeeded and are retried by the cyclic thread.
+ */
+void adsAsynPortDriver::rehandleFailedParams(uint16_t amsClientPort)
+{
+    handleRetryNeeded_ = false;
+    int fixed = 0, failed = 0;
+    // No asyn lock here: the bulk thread takes bulkReadInfoMutex_ and then the asyn lock (adsUpdateParameterLock),
+    // so taking them in the other order below would deadlock.
+    for (int i = 1; i < adsParamArrayCount_; i++)
+    {
+        adsParamInfo* p = &adsParamArray_[i];
+        if (!p->refreshNeeded || p->dataSource != ADS_DATASOURCE_PLC || p->isAdrCommand || p->bulkIndex < 0)
+        {
+            continue;
+        }
+        adsReleaseSymbolicHandle(amsClientPort, p, true);
+        if (adsGetSymHandleByName(amsClientPort, p) != asynSuccess)
+        {
+            handleRetryNeeded_ = true;
+            failed++;
+            continue;
+        }
+        {
+            std::lock_guard<std::mutex> lg(bulkReadInfoMutex_);
+            bulk[p->bulkIndex].sum[p->bulkOffset].iOffset = p->hSymbolicHandle;
+        }
+        p->refreshNeeded = false;
+        fixed++;
+    }
+    profLog("FIX_F15B_REHANDLE", "new handle for %d symbol(s), %d failed", fixed, failed);
+}
